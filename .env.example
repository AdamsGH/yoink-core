# Core
bot_token=
owner_id=
yoink_plugins=dl,stats,music,insight,inbox
yoink_rust_image=yoink/rust-backend:0.1.8
yoink_youtube_image=yoink/youtube-services:0.1.7

# Insight AI routing. A2A/auth2api is primary; set OPENROUTER_API_KEY to enable fallback.
gateway_base_url=http://0.0.0.0:8317/v1
gateway_api_key=
tldr_search_model=
tldr_search_timeout_seconds=90
openrouter_base_url=https://openrouter.ai/api/v1
openrouter_api_key=
ai_route_mode=auto
# tldr_llm_model=provider/model-id

# Local Bot API server (docker-compose.yml).
# Default uses official Telegram servers (50 MB upload limit).
# Set to http://tg-bot-api:8082/bot when running the local server (2 GB limit).
telegram_base_url=https://api.telegram.org/bot

# Telegram API credentials - required for the local Bot API server.
api_id=
api_hash=

# Host-mounted data directory. Must match the volume in docker-compose.yml.
# Contains: cookies/, tg-bot-api/ (user session token), kasm/
data_dir=/app/data

# Database
database_url=postgresql+asyncpg://yoink:yoink@yoink-postgres:5432/yoink
database_echo=false

# API server
api_port=8000
# api_secret_key has NO default - boot fails if unset. Generate with: openssl rand -hex 32
api_secret_key=
api_token_expire_minutes=1440

# Native Telegram transport. Raw long polling retains its separate poll deadline.
# YOINK_RUST_TELEGRAM_REQUEST_TIMEOUT_SECS=60

# Misc
debug=false
json_logs=false
default_language=en

# Host SOCKS proxy and its in-network HTTP facade. The HTTP facade is required
# for ffmpeg time-range downloads; ffmpeg cannot use SOCKS directly.
proxy_upstream_url=socks5://host.docker.internal:1080
proxy_url=http://yoink-proxy:8080
proxy_urls=["http://yoink-proxy:8080"]

# Domains routed through proxy_urls in dl plugin.
proxy_domains=["tiktok.com","vm.tiktok.com","vt.tiktok.com","e621.net","x.com","twitter.com"]
# Native automatic system-proxy routing, independent of the personal proxy toggle.
YOINK_RUST_DOWNLOAD_PROXY_DOMAINS_JSON=["youtube.com","youtu.be","tiktok.com","e621.net","x.com","twitter.com"]

# Rate limiting (dl plugin defaults; can be overridden per-user)
rate_limit_per_minute=5
rate_limit_per_hour=30
rate_limit_per_day=100

# Download limits
max_file_size_gb=2.0
max_playlist_count=50
download_timeout=1200
dl_ffmpeg_read_timeout=60
dl_ffmpeg_reconnect_delay_max=30
dl_ffmpeg_reconnect_delay_total_max=120
dl_ffmpeg_reconnect_max_retries=5

# yt-dlp POT provider (bgutil, docker-compose.yml).
# Leave youtube_pot_enabled=false to disable.
youtube_pot_enabled=false
youtube_pot_url=http://bgutil:4416

# Proxy for bgutil outbound traffic.
bgutil_proxy=${proxy_url}

# Browser-based cookie extraction (yt-dlp --cookies-from-browser).
# Populated by yoink-browser (profile: cookies). Leave empty to disable.
browser_profile_path=
browser_cookie_domains=["youtube.com","googlevideo.com","google.com","tiktok.com","www.tiktok.com"]

# yoink-browser (Kasmweb Chromium) - only used with profile: cookies
kasm_vnc_pw=changeme
kasm_launch_url=https://www.youtube.com

# Cookie pool - optional per-user account info enrichment
# Fetches real name/avatar from YouTube/Instagram/Twitter APIs on cookie upload.
# Leave empty to skip enrichment (cookies still work without it).
# YOUTUBE_INNERTUBE_KEY is not required - the default public key is used.
# INSTAGRAM_SESSION_ID is the sessionid cookie from an Instagram session.
cookie_youtube_sapisid=
cookie_instagram_session_id=

# IPv6 rotation for yt-dlp / gallery-dl outbound requests.
# Requires a routed /56 (or larger) prefix assigned to the host.
# Disabled by default - ISP must route the prefix to the Docker host.
# IPV6_DOMAINS: comma-separated domains to route through IPv6 (e.g. youtube.com,youtu.be)
IPV6_CIDR=
IPV6_DOMAINS=

# yoink-music plugin
MUSIC_SPOTIFY_CLIENT_ID=
MUSIC_SPOTIFY_CLIENT_SECRET=
MUSIC_PROXY_URL=${proxy_url}
MUSIC_PROXY_PLATFORMS=spotify,soundcloud,ytmusic,youtube
MUSIC_DOWNLOAD_ENABLED=false

# yoink-insight plugin
gemini_api_key=
gemini_model=gemini-3-flash-preview
# insight_default_lang=en
# insight_transcript_langs=en,ru
# OpenRouter BYOK key authentication request timeout.
# insight_byok_probe_timeout_seconds=10

# /tldr command uses the Insight AI routing settings above.
# tldr_llm_model=provider/model-id
# tldr_max_content_chars=40000
# tldr_rate_limit_per_day=20

# GitHub write access (star/unstar from yoink UI)
# Register a separate OAuth App at https://github.com/settings/developers with public_repo scope.
# Leave empty to disable the gh_write feature entirely.
github_oauth_public_repo_client_id=
github_oauth_public_repo_client_secret=

# Logging channels (optional)
log_channel=
log_exception_channel=

# Traefik domain for the frontend (traefik-kop)
yoink_domain=yoink.example.com

# S3 backup (optional - requires profile: backup)
backup_s3_endpoint=
backup_s3_bucket=yoink-backups
backup_s3_access_key=
backup_s3_secret_key=
backup_s3_region=garage
backup_retain_daily=7
backup_retain_weekly=4
backup_cron_schedule="0 3 * * *"

# Dev auth — /auth/dev endpoint for local development
# Restricted to DEV_ALLOWED_CIDR by nginx; never reachable from the internet.
# Set to your local network CIDR (e.g. 192.168.1.0/24 or 10.0.0.0/8).
DEV_AUTH_ENABLED=false
DEV_ALLOWED_CIDR=192.168.0.0/16

# Experimental native Rust downloader only; legacy Python does not read these.
# .env is not auto-loaded by the Rust server. Supply variables explicitly.
# Positive bounds: time quotas 1..1000000; active work 1..100. Invalid fails closed.
YOINK_RUST_DOWNLOAD_QUOTA_MINUTE=5
YOINK_RUST_DOWNLOAD_QUOTA_HOUR=30
YOINK_RUST_DOWNLOAD_QUOTA_DAY=100
YOINK_RUST_DOWNLOAD_MAX_ACTIVE_PER_USER=3
# Pending admission is separate and retains the server defaults 100/3.
# Only YOINK_RUST_OWNER_ID is time-quota exempt; owner active work is still bounded.

# Native Insight caps source downloads and provider responses at 1024..4194304 bytes.
# Raise to 4194304 for YouTube pages that exceed the 1 MiB default.
YOINK_RUST_INSIGHT_RESPONSE_MAX_BYTES=1048576

# Music upstream bodies allow 1024..8388608 bytes, independent of audio file size.
# YouTube audio extraction can require 4194304 even for a small MP3.
YOINK_RUST_MUSIC_WORKER_RESPONSE_BYTES=1048576

# Native personal cookie storage bounds (non-pool UTF-8 bytes; imported data retained).
YOINK_RUST_PERSONAL_COOKIE_DOMAINS=128
YOINK_RUST_PERSONAL_COOKIE_ACTOR_BYTES=67108864
YOINK_RUST_PERSONAL_COOKIE_GLOBAL_BYTES=1073741824

# Native backend cookie controls. The Python deployment ignores these names.
# Set an HTTPS origin to enable cookie WebApp links. Leave it unset to hide them.
# YOINK_RUST_COOKIE_WEB_ORIGIN=https://yoink.example
YOINK_RUST_COOKIE_OAUTH_TIMEOUT_SECS=15
YOINK_RUST_COOKIE_ACCOUNT_TIMEOUT_SECS=10

# Enables only the fixed native Unix gateway. Trusted services need separate packaging.
YOINK_RUST_YOUTUBE_AUTH_ADAPTER_ENABLED=false
YOINK_RUST_COOKIE_OAUTH_POLL_BUDGET_SECS=120
YOINK_RUST_COOKIE_OAUTH_RESULT_RETENTION_SECS=1800
YOINK_RUST_COOKIE_OAUTH_MAX_INFLIGHT=128
YOINK_RUST_COOKIE_OAUTH_CLEANUP_INTERVAL_SECS=60
# Must exceed the poll budget by more than five seconds when downloads are enabled.
YOINK_RUST_SHUTDOWN_TIMEOUT_SECS=135

# Compose uses the local Bot API. Keep file and scratch limits bounded separately.
# A standalone backend using the public Bot API retains its 20 MiB default.
YOINK_RUST_DOWNLOAD_MAX_BYTES=2000000000
YOINK_RUST_DOWNLOAD_WORKSPACE_MAX_BYTES=8000000000

# Native AI requires locally-resolving SOCKS5 for every provider, including BYOK.
# Compose uses proxy_upstream_url unless this override is set. No direct fallback.
# YOINK_RUST_INSIGHT_AI_PROXY=socks5://host.docker.internal:1080
