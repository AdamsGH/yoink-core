diff --git a/telegram-bot-api/Client.cpp b/telegram-bot-api/Client.cpp
index 91c33e6..28b8b2c 100644
--- a/telegram-bot-api/Client.cpp
+++ b/telegram-bot-api/Client.cpp
@@ -14445,6 +14445,16 @@ void Client::on_cmd(PromisedQueryPtr query, bool force) {
     } else if (query->method() == "registeruser" && parameters_->allow_users_registration_) {
       return process_register_user_query(query);
     } else {
+      // Proxy access must be available before login so TDLib can reach Telegram through SOCKS5.
+      auto method = query->method().str();
+      if (method == "addproxy" || method == "getproxies" || method == "enableproxy" ||
+          method == "disableproxy" || method == "deleteproxy") {
+        auto method_it = methods_.find(method);
+        if (method_it != methods_.end()) {
+          (this->*(method_it->second))(query);
+          return;
+        }
+      }
       return fail_query(404, "Not Found: method not found or login not yet completed", std::move(query));
     }
   }
