+  auto limit = get_integer_arg(query.get(), "limit", 100, 1, 100);
+  check_chat(chat_id, AccessRights::Read, std::move(query),
+             [this, query_string = std::move(query_string), offset_date, offset_message_id, offset_forum_topic_id,
+              limit](int64 chat_id, PromisedQueryPtr query) {
