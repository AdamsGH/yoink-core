+td::Status Client::process_get_forum_topic_query(PromisedQueryPtr &query) {
+  auto chat_id = query->arg("chat_id");
+  auto forum_topic_id = get_forum_topic_id(query.get(), "message_thread_id");
+  check_chat(chat_id, AccessRights::Read, std::move(query), [this, forum_topic_id](int64 chat_id, PromisedQueryPtr query) {
+    send_request(make_object<td_api::getForumTopic>(chat_id, forum_topic_id),
