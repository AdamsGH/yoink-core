# Context: repository root. No npm dependencies; source is the reviewed Unix adapter.
FROM node:22.16.0-bookworm-slim@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34
RUN groupadd -g 10001 yoink && useradd -u 10001 -g yoink --no-create-home yoink
COPY backend/worker/youtube_auth_adapter.mjs /opt/adapter.mjs
COPY backend/scripts/youtube-auth-gateway-limits.mjs /opt/limits.mjs
USER 10001:10001
ENV YOINK_YOUTUBE_AUTH_SOCKET=/run/yoink-youtube-auth/adapter.sock
# Directory is dedicated to this topology/tenant; never share it between backends.
CMD ["sh", "-ec", "rm -f /run/yoink-youtube-auth/adapter.sock; exec node --import /opt/limits.mjs /opt/adapter.mjs"]
