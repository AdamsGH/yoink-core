# Consumer-parsed native inline example. This does not start services.
YOINK_RUST_TELEGRAM_ENABLED=true
YOINK_RUST_TELEGRAM_TOKEN=7:fixture-only-token
YOINK_RUST_OWNER_ID=42
YOINK_RUST_DATABASE_PATH=/tmp/yoink-inline-example.db
YOINK_RUST_DOWNLOADS_ENABLED=true
YOINK_RUST_TELEGRAM_INLINE_CONCURRENCY=3
YOINK_RUST_TELEGRAM_INLINE_TIMEOUT_SECS=20
YOINK_RUST_TELEGRAM_INLINE_REQUESTS_PER_SECOND=10
YOINK_RUST_TELEGRAM_INLINE_ACTOR_INTERVAL_MS=300
# Optional operator-wide egress. Inline search never uses a user's proxy/cookies.
# YOINK_RUST_DOWNLOAD_PROXY_URL=http://operator-proxy.example:8080
