set shell := ["bash", "-euo", "pipefail", "-c"]

# All commands run from this experimental workspace, never the Python backend.
default:
    @just --list

# Resolve new dependencies when intentionally updating Cargo.lock.
fetch:
    cargo fetch

# Inspect the actual legacy Alembic schema in a disposable container, never production.
inspect-legacy-schema:
    node scripts/inspect-legacy-schema.mjs

# Regenerate the reviewed native application schema, then inspect its diff.
generate-schema:
    node scripts/native-schema.mjs

check-schema-source:
    node scripts/native-schema.mjs --check

# Resolve the isolated Turso experiment, without changing server dependencies.
fetch-turso:
    cargo fetch --manifest-path experiments/turso/Cargo.toml

format-turso:
    cargo fmt --manifest-path experiments/turso/Cargo.toml

# Check the isolated experiment against the server's pinned compiler in Docker.
verify-turso-container:
    docker build --progress=plain -f Dockerfile.turso-probe -t yoink/turso-probe:experimental .

# Native embedded-engine contracts. Only disposable test databases are opened.
verify-turso:
    cargo fmt --manifest-path experiments/turso/Cargo.toml -- --check
    cargo clippy --manifest-path experiments/turso/Cargo.toml --target-dir target/turso-probe --locked --all-targets -- -D warnings
    cargo test --manifest-path experiments/turso/Cargo.toml --target-dir target/turso-probe --locked --no-run
    timeout --kill-after=5s 90s cargo test --manifest-path experiments/turso/Cargo.toml --target-dir target/turso-probe --locked -- --nocapture

# Reconcile workspace dependency lists without upgrading already locked dependencies.
lock:
    cargo update --workspace --offline

format:
    cargo fmt --all

fmt:
    cargo fmt --all -- --check

lint:
    cargo clippy --workspace --all-targets --all-features --locked -- -D warnings

test:
    cargo test --workspace --all-features --locked

# Focused contracts or adapter verification while other crates are being integrated.
test-crate crate:
    cargo test --locked --message-format short -p {{quote(crate)}}

build:
    cargo build --workspace --locked

smoke: build
    node --test scripts/smoke.mjs

# Independent worker target avoids requiring an integrated Rust build for Python checks.
build-worker:
    docker build --quiet --target worker-runtime -t yoink/rust-worker:experimental .

# Python executes only in an isolated container. Its HTTP fixture uses loopback.
test-worker pattern='test_*.py': build-worker
    docker run --rm --pull never --network none --entrypoint python --mount type=bind,source={{justfile_directory()}}/worker,target=/worker,readonly yoink/rust-worker:experimental -B -m unittest discover -s /worker -p {{quote(pattern)}}

# Inspect pinned worker dependency APIs without host Python or network access.
inspect-worker-symbol module symbol='':
    docker run --rm --pull never --network none --entrypoint python yoink/rust-worker:experimental -B -c 'import importlib, inspect, functools, sys; m = importlib.import_module(sys.argv[1]); print(inspect.getsource(functools.reduce(getattr, sys.argv[2].split("."), m)) if sys.argv[2] else "\n".join(sorted(k for k,v in vars(m).items() if inspect.isfunction(v) or inspect.isclass(v))))' {{quote(module)}} {{quote(symbol)}}

# Run storage DB regressions independently while adapter integration is in flight.
test-storage-db:
    node scripts/test-db.mjs --storage-only

# Native profile/credential contracts without rebuilding transport adapters.
test-profile-db:
    node scripts/test-db.mjs --profiles-only

# Native disk databases and production process lifecycle, all in private temporary directories.
test-db: build
    node scripts/test-db.mjs

# Compare the approved search contract with the actual legacy FTS trigger on disposable data.
test-stats-search-oracle:
    node scripts/test-stats-search.mjs

test-stats-search: (test-crate "yoink-stats-search") test-stats-search-oracle

verify-stats-search-container:
    docker build --target stats-search-tests -t yoink/rust-stats-search-tests:experimental .

# Offline import utility. PostgreSQL client dependencies stay outside yoink-server.
build-import:
    cargo build --locked -p yoink-import

# Requires explicit YOINK_IMPORT_SOURCE_URL and a new destination in a private directory.
import-postgres destination: build-import
    target/debug/yoink-import --destination {{quote(destination)}}

# Actual Alembic source, read-only import and native value/safety assertions.
test-import image='': build-import build-ops
    node --test scripts/import-fixture/process.test.mjs
    cargo build --locked -p yoink-server --features test-fixtures --bin yoink-fixture-server
    node scripts/import-fixture/test-import.mjs {{quote(image)}}

# Build and check the operator CLI against the pinned deployment compiler.
build-import-image:
    docker build --target importer -t yoink/rust-importer:experimental .
    docker run --rm --pull never --network none --read-only yoink/rust-importer:experimental --help

verify-import: verify build-import-image (test-import "yoink/rust-importer:experimental")

# Safe operator commands require explicit source and new destination paths.
build-ops:
    cargo build --locked -p yoink-ops

backup source destination: build-ops
    target/debug/yoink-ops backup --source {{quote(source)}} --destination {{quote(destination)}}

restore source destination: build-ops
    target/debug/yoink-ops restore --source {{quote(source)}} --destination {{quote(destination)}}

build-ops-image:
    docker build --target operations -t yoink/rust-operations:experimental .
    docker run --rm --pull never --network none --read-only yoink/rust-operations:experimental --help

# Production-shaped PostgreSQL import -> native backup -> restored native values.
test-ops image='': build-import build-ops
    cargo build --locked -p yoink-server --features test-fixtures --bin yoink-fixture-server
    YOINK_OPS_TEST_IMAGE={{quote(image)}} node scripts/import-fixture/test-import.mjs

verify-ops: verify build-ops-image (test-ops "yoink/rust-operations:experimental")

# Opt-in image only, never changes the existing Compose deployment.
build-media:
    docker build --target runtime -t yoink/rust-backend:experimental .

# Isolated fixture controller is absent from the default production image.
build-media-fixture:
    docker build --target media-fixture -t yoink/rust-backend-fixture:experimental .

# Exact default launcher in the deployment's hardened, network-isolated profile.
test-worker-launcher:
    node scripts/test-worker-launcher.mjs

# Disposable native DB, fixture Bot API and real container Python worker.
test-media:
    node scripts/test-media.mjs

verify-media: build-media build-media-fixture test-worker test-worker-launcher test-media

check-docs:
    node scripts/check-docs.mjs

check-scripts:
    node scripts/check-scripts.mjs

# Deterministic transport/lifecycle fixture contracts without Docker.
test-media-fixtures:
    node --test scripts/media-fixture/*.test.mjs

verify: fmt lint test smoke check-scripts check-schema-source test-media-fixtures check-docs

verify-db: verify test-db

run:
    cargo run --locked -p yoink-server

# Explicitly mutating. Requires a deliberately supplied private database path.
migrate:
    cargo run --locked -p yoink-server -- migrate

check-schema:
    cargo run --locked -p yoink-server -- check-schema
