set shell := ["bash", "-euo", "pipefail", "-c"]

# All commands run from this experimental workspace, never the Python backend.
default:
    @just --list

# Resolve new dependencies when intentionally updating Cargo.lock.
fetch:
    cargo fetch

format:
    cargo fmt --all

fmt:
    cargo fmt --all -- --check

lint:
    cargo clippy --workspace --all-targets --locked -- -D warnings

test:
    cargo test --workspace --locked

build:
    cargo build --workspace --locked

smoke: build
    node --test scripts/smoke.mjs

# Requires local postgres:16-alpine and yoink/yoink:latest images. Owns its test DB.
test-db: build
    node scripts/test-db.mjs

check-docs:
    node scripts/check-docs.mjs

check-scripts:
    node --check scripts/smoke.mjs
    node --check scripts/test-db.mjs
    node --check scripts/check-docs.mjs

verify: fmt lint test smoke check-scripts check-docs

verify-db: verify test-db

run:
    cargo run --locked -p yoink-server

# Explicitly mutating. Requires a deliberately supplied isolated database URL.
migrate:
    cargo run --locked -p yoink-server -- migrate

check-schema:
    cargo run --locked -p yoink-server -- check-schema
